# Copy to .env (repo root) and change every password. Never commit .env.
# Docker Compose, the Python ETL and the Next.js app all read this one file.

# MySQL (docker publishes it on 3307 so it never clashes with a local MySQL on 3306)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=threatlattice
MYSQL_ROOT_PASSWORD=change-me-root      # ETL + docker only
MYSQL_APP_USER=tl_app                   # Next.js app only (SELECT/INSERT/UPDATE/DELETE/EXECUTE)
MYSQL_APP_PASSWORD=change-me-app

# Neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j          # at least 8 characters

# Session signing key, at least 32 random characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=replace-with-48-random-characters-before-first-run

# Demo accounts created by `python -m etl.seed_users` (min 10 characters).
# Leave empty to have random passwords generated and printed once.
SEED_ADMIN_PASSWORD=
SEED_ANALYST_PASSWORD=
